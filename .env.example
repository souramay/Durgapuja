# ==============================================================================
# Sharodiya (Durgapuja) — Environment Variables for Vercel Deployment
# ==============================================================================
# Add these in your Vercel Project -> Settings -> Environment Variables.

# Supabase Credentials (Server-side API & Edge Functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Email to receive instant ad submission leads
NOTIFICATION_EMAIL=admin@example.com

# Email Service Provider (Option 1: Resend - Recommended for Vercel)
# Sign up at https://resend.com and grab an API key:
RESEND_API_KEY=

# Email Service Provider (Option 2: Custom SMTP / Gmail App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=admin@example.com
# SMTP_PASS=your-16-char-gmail-app-password
